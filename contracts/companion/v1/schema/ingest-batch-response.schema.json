{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeetcraft.dev/contracts/companion/v1/schema/ingest-batch-response.schema.json",
  "$comment": "Status: Draft — reviewed, not implemented",
  "title": "Companion ingest batch response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "results"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "batchId": {
      "$ref": "#/$defs/uuid"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/eventResult"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "type": "string",
      "enum": ["accepted", "duplicate", "needs_review", "rejected"]
    },
    "resultCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "eventResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientEventId", "outcome", "code"],
      "properties": {
        "clientEventId": {
          "$ref": "#/$defs/sha256Digest"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "code": {
          "$ref": "#/$defs/resultCode"
        },
        "serverEventId": {
          "$ref": "#/$defs/uuid"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": ["accepted", "duplicate"]
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "required": ["serverEventId"]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accepted"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "code": {
                "const": "accepted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "duplicate"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "code": {
                "const": "duplicate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": ["needs_review", "rejected"]
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "serverEventId": false
            }
          }
        }
      ]
    }
  }
}
