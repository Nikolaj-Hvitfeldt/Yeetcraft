# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Required for PATCH /api/stats/batch. Leave empty only in tests that expect writes to be rejected.
# An empty API_KEY does not enable writes; the server fails closed on mutation requests.
API_KEY=your-write-token-here

# Supabase PostgreSQL
# Copy values from Supabase Dashboard → Project Settings → Database
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
