# Supabase Postgres (use one of the two options below)

# Option 1: Full connection string (recommended for Supabase)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Option 2: Separate variables
# DB_HOST=db.YOUR_PROJECT.supabase.co
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=YOUR_PASSWORD
# DB_SSL_MODE=require

# Supabase JWT verification (Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# Admin email (same as your Supabase Auth user; gets full access)
SUPABASE_ADMIN_EMAIL=your@email.com

# Optional: legacy shared-link API key
# API_KEY=optional-shared-secret
