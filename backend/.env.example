# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Required for PATCH /api/stats/batch in normal operation.
# An empty or missing API_KEY does not enable writes; the server fails closed (503 on mutation requests).
API_KEY=your-write-token-here

# Optional comma-separated browser origins for CORS (defaults to local Vite dev/preview/E2E origins).
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:14173

# Supabase PostgreSQL
# Copy values from Supabase Dashboard → Project Settings → Database
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Test database (testdb, integration, E2E only; set in shell, not dev .env) ---
# YEETCRAFT_TEST_MODE=1
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:55432/yeetcraft_test?sslmode=disable
# API_KEY and E2E_WRITE_TOKEN must match for Playwright write tests (use non-production test secrets)
# E2E_WRITE_TOKEN=e2e-test-token
